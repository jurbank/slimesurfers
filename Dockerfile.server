FROM node:22-alpine AS base
RUN apk add --no-cache git
RUN corepack enable && corepack prepare pnpm@10.33.0 --activate
WORKDIR /app

# Copy manifests for dependency install
COPY pnpm-lock.yaml pnpm-workspace.yaml package.json ./
COPY apps/game/server/package.json ./apps/game/server/
COPY packages/content/package.json ./packages/content/
COPY packages/protocol/package.json ./packages/protocol/
COPY packages/simulation/package.json ./packages/simulation/

RUN pnpm install --frozen-lockfile --filter @splat/game-server...

# Copy source
COPY apps/game/server ./apps/game/server
COPY packages ./packages

EXPOSE 2567
CMD ["pnpm", "--filter", "@splat/game-server", "exec", "tsx", "src/index.ts"]
